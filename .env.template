# EKVAAR OS - Environment Variables Template
# Copy to GitHub Secrets - DO NOT commit actual values

# Authentication
NEXTAUTH_SECRET=  # Generate: openssl rand -base64 32
NEXTAUTH_URL=https://os.ekvaar.com
NEXT_PUBLIC_APP_URL=https://os.ekvaar.com
ARTIFACT_SIGNING_SECRET= # Generate: openssl rand -hex 32
JWT_SECRET=       # Generate: openssl rand -base64 32

# Google OAuth
GOOGLE_CLIENT_ID=     # From: console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_SECRET= # From: console.cloud.google.com/apis/credentials

# AI/LLM, speech, and Composio credentials are configured per organization
# inside OS Settings. Do not place shared provider keys in this server file.

# Integrations
META_CLIENT_ID=
META_CLIENT_SECRET=
META_GRAPH_VERSION=v25.0
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202606

# Self-hosted workflow, routing, and memory
N8N_ENCRYPTION_KEY=   # Generate: openssl rand -hex 32
N8N_HOST=os.ekvaar.com
N8N_EDITOR_BASE_URL=https://os.ekvaar.com/automation/
N8N_WEBHOOK_URL=https://os.ekvaar.com/automation/
N8N_EKVAAR_WEBHOOK_URL=http://n8n:5678/automation/webhook/ekvaar-marketing
N8N_EKVAAR_WEBHOOK_SECRET= # Generate: openssl rand -hex 32
N8N_EKVAAR_WORKFLOW_ID=
N8N_EKVAAR_EDITOR_URL=/automation/
COGNEE_LLM_API_KEY= # Generate: openssl rand -hex 32
COGNEE_LLM_MODEL=openai/auto
DOGRAH_API_URL=
OPEN_DESIGN_API_TOKEN= # Generate: openssl rand -hex 32
OPEN_DESIGN_ALLOWED_ORIGINS=https://os.ekvaar.com
OPEN_DESIGN_PUBLIC_URL=

# Database (Supabase PostgreSQL). URL-encode special password characters.
# Runtime: Transaction Pooler (6543). CLI: Session Pooler (5432).
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5
DIRECT_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Redis (BullMQ)
REDIS_URL=redis://redis:6379

# AWS region/model defaults only. Bedrock credentials belong in OS Settings.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
