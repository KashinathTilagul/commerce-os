    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5",
    "typescript-eslint": "^8.63.0"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "^0.35.3",
    "find-my-way": "^9.7.0",
    "brace-expansion": "^5.0.8",
    "valibot": "^1.4.2",
    "nanoid": "^3.3.18",
    "glob": "^11.0.0"
  }
}
