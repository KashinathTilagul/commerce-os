{
  "name": "commerce-os",
  "version": "3.5.0",
  "description": "Commerce OS — Open-Core Commerce Desktop Operating System by Kashinath Tilagul / ABATA",
  "author": "Kashinath Tilagul <kashinathtilagul8@gmail.com>",
  "homepage": "https://github.com/KashinathTilagul/Ekvaar#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/KashinathTilagul/Ekvaar.git"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "test": "node --import tsx --test --test-force-exit src/lib/account-password.test.ts src/lib/commerce/woocommerce-provider.test.ts src/lib/product-launches.test.ts src/lib/campaign-workforce.test.ts src/lib/agent-playbooks.test.ts src/lib/omniroute-config.test.ts src/lib/direct-provider.test.ts src/lib/viewer-guard.test.ts src/lib/theme-store.test.ts src/lib/window-store.test.ts && node --import tsx --test --test-force-exit src/lib/security.test.ts",
    "test:all": "npm run test && npm run test:hotfixes && npm run test:guards",
    "test:playbooks": "node --import tsx --test src/lib/agent-playbooks.test.ts",
    "test:woocommerce": "node --import tsx --test src/lib/commerce/woocommerce-provider.test.ts",
    "test:hotfixes": "node --import tsx --test --test-force-exit src/lib/cron-auth.test.ts src/lib/omniroute-config.test.ts src/lib/storage-security.test.ts src/lib/chat-security.test.ts src/lib/host-routing.test.ts && bun test src/lib/account-delete.test.js",
    "test:guards": "bun test src/lib/publishing-guards.test.js && bun test src/lib/scheduler-lock.test.js && bun test src/lib/commerce/sync-engine.test.js && bun test src/lib/commerce/webhook.test.js && bun test src/lib/chat-flow.test.js",
    "test:product-launches": "node --import tsx --test src/lib/product-launches.test.ts",
    "test:campaign-workforce": "node --import tsx --test src/lib/campaign-workforce.test.ts",
    "test:security": "node --import tsx --test --test-force-exit src/lib/security.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "lint": "eslint .",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "seed": "bun run scripts/seed.ts",
    "seed:demo": "tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.41",
    "@ai-sdk/openai": "^4.0.20",
    "@auth/prisma-adapter": "^2.11.3",
    "@composio/core": "^0.13.1",
    "@prisma/config": "^7.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.0",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@sparticuz/chromium": "^149.0.0",
    "@tanstack/react-query": "^5.82.0",
    "ai": "^7.0.22",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "framer-motion": "^11.0.0",
    "handlebars": "^4.7.9",
    "ioredis": "^5.6.1",
    "lucide-react": "^0.525.0",
    "next": "^16.3.8",
    "next-auth": "^4.24.15",
    "pg": "^8.22.0",
    "postcss": "^8.5.10",
    "prisma": "^7.9.1",
    "puppeteer-core": "^25.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "fast-uri": "^3.1.8",
    "undici": "^7.29.1",
    "js-yaml": "^4.3.2",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.0.2",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.2.10",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5",
    "typescript-eslint": "^8.63.0"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "$sharp",
    "find-my-way": "^9.7.0",
    "minimatch@3.1.5": {
      "brace-expansion": "^1.1.21"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "^5.0.12"
    },
    "valibot": "^1.4.2",
    "nanoid": "^3.3.18",
    "glob": "^11.0.0",
    "deepmerge-ts": "^8.0.1",
    "@prisma/config": {
      "deepmerge-ts": "^8.0.1"
    },
    "mysql2": "^3.24.3",
    "browserslist": "^4.28.7"
  },
  "pnpm": {
    "overrides": {
      "mysql2": "^3.24.3",
      "browserslist": "^4.28.7",
      "@prisma/config>deepmerge-ts": "^8.0.1"
    }
  }
}
