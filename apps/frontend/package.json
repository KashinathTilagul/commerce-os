{
  "name": "fashion-os",
  "version": "3.5.0",
  "description": "Fashion OS — Open-Core Retail & E-Commerce Desktop Operating System created by Kashinath Tilagul / EKVAAR",
  "author": "Kashinath Tilagul <kashinathtilagul8@gmail.com>",
  "homepage": "https://github.com/KashinathTilagul/Ekvaar#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/KashinathTilagul/Ekvaar.git"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "test": "node --import tsx --test --test-force-exit src/lib/account-password.test.ts src/lib/commerce/shopify-provider.test.ts src/lib/product-launches.test.ts src/lib/campaign-workforce.test.ts src/lib/agent-playbooks.test.ts && node --import tsx --test --test-force-exit src/lib/security.test.ts",
    "test:all": "npm run test",
    "test:playbooks": "node --import tsx --test src/lib/agent-playbooks.test.ts",
    "test:shopify": "node --import tsx --test src/lib/commerce/shopify-provider.test.ts",
    "test:product-launches": "node --import tsx --test src/lib/product-launches.test.ts",
    "test:campaign-workforce": "node --import tsx --test src/lib/campaign-workforce.test.ts",
    "test:security": "node --import tsx --test --test-force-exit src/lib/security.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "lint": "eslint .",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "seed": "bun run scripts/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^5.0.17",
