    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.0.0",
    "handlebars": "^4.7.9",
    "ioredis": "^5.6.1",
    "lucide-react": "^0.525.0",
    "next": "^16.2.12",
    "next-auth": "^4.24.15",
    "pg": "^8.22.0",
    "postcss": "^8.5.10",
    "prisma": "^7.9.0",
    "puppeteer-core": "^25.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.0.2",
    "zustand": "^5.0.6"
