FROM debian:bookworm-slim AS capture-builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libx11-dev \
    libxdamage-dev \
    libxext-dev \
    libxfixes-dev \
    libxtst-dev \
    libpng-dev \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY vendor/rakazo/infra/sandboxes/computer/xcapture.c .
RUN cc -O3 -fPIC -shared -Wall -Wextra -Werror -o librakazo-xcapture.so xcapture.c \
    -lX11 -lXext -lXdamage -lXfixes -lXtst -lpng

FROM node:22-bookworm-slim

# Debian's novnc/websockify packages pull a large Python scientific and
# OpenStack dependency tree. Use the upstream Node packages instead so this
# runtime can be extracted on the production host without exhausting disk.
RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb \
    x11vnc \
    fluxbox \
    xterm \
    xdotool \
    x11-utils \
    x11-xserver-utils \
    python3 \
    ca-certificates \
    procps \
    bash \
    chromium \
    fonts-liberation \
    fonts-dejavu-core \
    dbus-x11 \
  && rm -rf /var/lib/apt/lists/* \
  && npm install --global --omit=dev websockify@0.7.1 @novnc/novnc@1.7.0 \
  && mkdir -p /usr/share/novnc \
  && cp -R /usr/local/lib/node_modules/@novnc/novnc/* /usr/share/novnc/ \
  && npm cache clean --force \
  && groupadd --gid 1000 rakazo \
  && useradd --uid 1000 --gid rakazo --create-home --shell /bin/bash rakazo \
  && mkdir -p /etc/rakazo/fluxbox \
  && printf '%s\n' '#!/bin/sh' 'exec xsetroot -solid "#111113" "$@"' > /usr/bin/fbsetbg \
  && chmod +x /usr/bin/fbsetbg \
  && ln -sfn /bin/true /usr/bin/xmessage

ENV DISPLAY=:1
ENV HOME=/home/rakazo
WORKDIR /home/rakazo

COPY --chmod=755 vendor/rakazo/infra/sandboxes/computer/start.sh /usr/local/bin/rakazo-computer
COPY --chmod=755 vendor/rakazo/infra/sandboxes/computer/control.py /usr/local/bin/rakazo-computer-control
COPY --from=capture-builder /build/librakazo-xcapture.so /usr/local/lib/librakazo-xcapture.so
COPY --chmod=755 vendor/rakazo/infra/sandboxes/computer/rakazo-browser /usr/local/bin/rakazo-browser
COPY --chmod=644 vendor/rakazo/infra/sandboxes/computer/fluxbox.init /etc/rakazo/fluxbox/init
COPY --chmod=644 vendor/rakazo/infra/sandboxes/computer/fluxbox.apps /etc/rakazo/fluxbox/apps
COPY --chmod=644 vendor/rakazo/infra/sandboxes/computer/fluxbox.menu /etc/rakazo/fluxbox/menu
COPY --chmod=644 vendor/rakazo/infra/sandboxes/computer/embed.html /usr/share/novnc/embed.html

RUN ldconfig \
  && sed -i 's/\r$//' /usr/local/bin/rakazo-computer /usr/local/bin/rakazo-computer-control /usr/local/bin/rakazo-browser \
    /etc/rakazo/fluxbox/init /etc/rakazo/fluxbox/apps /etc/rakazo/fluxbox/menu \
  && sed -i 's/websockify --heartbeat=30 --web=/websockify --web=/' /usr/local/bin/rakazo-computer

EXPOSE 7070 6080 6081 6082 6083 6084 6085 6086 6087 6088 6089 6090 6091 6092 6093 6094 6095
USER 1000:1000
CMD ["/usr/local/bin/rakazo-computer"]
