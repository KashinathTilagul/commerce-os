FROM node:22-bookworm-slim

WORKDIR /app
COPY vendor/rakazo/pnpm-workspace.yaml vendor/rakazo/pnpm-lock.yaml vendor/rakazo/package.json ./
COPY vendor/rakazo/packages/contracts packages/contracts
COPY vendor/rakazo/packages/core packages/core
COPY vendor/rakazo/infra/sandboxes/supervisor infra/sandboxes/supervisor
RUN corepack enable \
  && pnpm install --no-frozen-lockfile --prod --filter "@rakazo/sandbox-supervisor..."

WORKDIR /app/infra/sandboxes/supervisor
CMD ["pnpm", "exec", "tsx", "src/index.ts"]
