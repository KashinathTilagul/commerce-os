# EKVAAR OS — Environment Variables
# Copy this file to .env and fill in your values

# ═══════════════════════════════════════════════════════════════
# DATABASE
# ═══════════════════════════════════════════════════════════════
# SQLite path — relative for local, absolute for Docker
DATABASE_URL=file:./apps/frontend/db/custom.db

# ═══════════════════════════════════════════════════════════════
# AUTHENTICATION
# ═══════════════════════════════════════════════════════════════
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-in-production
NEXTAUTH_URL=https://os.ekvaar.com

# ═══════════════════════════════════════════════════════════════
# AI / LLM PROVIDERS (Already configured - don't touch)
# ═══════════════════════════════════════════════════════════════
# AWS Bedrock — Krishna intelligence
# BEDROCK_API_KEY=...
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=amazon-bedrock/zai.glm-5

# ═══════════════════════════════════════════════════════════════
# INTEGRATIONS
# ═══════════════════════════════════════════════════════════════
# Composio — integration layer for Shopify, Gmail, Slack, etc.
COMPOSIO_API_KEY=composio_live_xxx
# Optional when using a different Composio project; defaults to EKVAAR's organization-safe Shopify config.
# COMPOSIO_SHOPIFY_AUTH_CONFIG_ID=ac_your_shopify_api_key_config

# Shopify (optional — for syncing real orders)
# SHOPIFY_STORE_URL=https://your-store.myshopify.com
# SHOPIFY_ACCESS_TOKEN=shpat_xxx

# ═══════════════════════════════════════════════════════════════
# ENVIRONMENT
# ═══════════════════════════════════════════════════════════════
ENV=production
NODE_ENV=production
