# EKVAAR OS — Environment Variables Example

# ═══════════════════════════════════════════════════════════════
# SUPABASE DATABASE & AUTH
# ═══════════════════════════════════════════════════════════════
SUPABASE_PROJECT_REF=guxaxhofeglqkmrhahsw
NEXT_PUBLIC_SUPABASE_URL=https://guxaxhofeglqkmrhahsw.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_tEdI0xEM1rs4Nye2PotXpw_B3hXTslt
SUPABASE_ANON_KEY=sb_publishable_tEdI0xEM1rs4Nye2PotXpw_B3hXTslt

# Runtime connection. Copy the Transaction Pooler URL from Supabase Connect.
# URL-encode special characters in YOUR_PASSWORD. Transaction mode requires
# pgbouncer=true because it does not support prepared statements.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5

# CLI/migrations connection. Copy the Session Pooler URL from Supabase Connect.
# This repository's Prisma config uses DIRECT_URL for CLI commands when present.
DIRECT_URL=postgresql://postgres.PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ═══════════════════════════════════════════════════════════════
# REDIS QUEUE
# ═══════════════════════════════════════════════════════════════
REDIS_URL=redis://localhost:6379

# ═══════════════════════════════════════════════════════════════
# AUTHENTICATION
# ═══════════════════════════════════════════════════════════════
NEXTAUTH_SECRET=change-me-in-production
JWT_SECRET=change-me-in-production
CRON_SECRET=change-me-in-production
NEXTAUTH_URL=https://os.ekvaar.com
NEXT_PUBLIC_APP_URL=https://os.ekvaar.com
ARTIFACT_SIGNING_SECRET=generate-with-openssl-rand-hex-32

# ═══════════════════════════════════════════════════════════════
# INTEGRATIONS
# ═══════════════════════════════════════════════════════════════
# Composio and AI/speech keys are entered per organization in OS Settings.
META_CLIENT_ID=
META_CLIENT_SECRET=
META_GRAPH_VERSION=v25.0
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202606

# Self-hosted AI/workflow/memory services
N8N_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32
N8N_HOST=os.ekvaar.com
N8N_EDITOR_BASE_URL=https://os.ekvaar.com/automation/
N8N_WEBHOOK_URL=https://os.ekvaar.com/automation/
N8N_EKVAAR_WEBHOOK_URL=http://n8n:5678/automation/webhook/ekvaar-marketing
N8N_EKVAAR_WEBHOOK_SECRET=generate-with-openssl-rand-hex-32
N8N_EKVAAR_WORKFLOW_ID=
N8N_EKVAAR_EDITOR_URL=/automation/
COGNEE_LLM_API_KEY=generate-with-openssl-rand-hex-32
COGNEE_LLM_MODEL=openai/auto
DOGRAH_API_URL=
OPEN_DESIGN_API_TOKEN=generate-with-openssl-rand-hex-32
OPEN_DESIGN_ALLOWED_ORIGINS=https://os.ekvaar.com
OPEN_DESIGN_PUBLIC_URL=
RAKAZO_PUBLIC_URL=

# ENVIRONMENT
ENV=production
NODE_ENV=production
CAMPAIGN_LAUNCHES_ENABLED=false
