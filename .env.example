# COMMERCE OS — Environment Variables Example
# Copy to .env and customize for your deployment.
# With Docker Compose, Postgres and Redis start automatically and runtime
# secrets are generated on first boot if left blank.

# ═══════════════════════════════════════════════════════════════
# DATABASE (Bundled Docker Postgres OR external PostgreSQL/Supabase)
# ═══════════════════════════════════════════════════════════════
POSTGRES_USER=commerce
POSTGRES_PASSWORD=commerce
POSTGRES_DB=commerce

# Leave unset in Docker Compose to use the bundled postgres service, or set to
# an external PostgreSQL / Supabase connection string:
#   Supabase Transaction Pooler (port 6543): ?pgbouncer=true&connection_limit=5
#   Supabase Session Pooler (port 5432) for DIRECT_URL
DATABASE_URL=
DIRECT_URL=

# Optional Supabase client credentials (only if using Supabase Auth/Storage)
SUPABASE_PROJECT_REF=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=

# ═══════════════════════════════════════════════════════════════
# REDIS QUEUE
# ═══════════════════════════════════════════════════════════════
REDIS_URL=redis://localhost:6379

# ═══════════════════════════════════════════════════════════════
# AUTHENTICATION & PUBLIC ORIGIN
# ═══════════════════════════════════════════════════════════════
# Leave blank in Docker Compose to auto-generate once in storage/.runtime-secrets,
# or generate manually with: openssl rand -hex 32
NEXTAUTH_SECRET=
JWT_SECRET=
CRON_SECRET=
ARTIFACT_SIGNING_SECRET=

# Match your public URL (e.g. http://localhost:3000 or https://os.yourdomain.com)
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ═══════════════════════════════════════════════════════════════
# INTEGRATIONS (Optional — provider keys can also be set per-org in Settings)
# ═══════════════════════════════════════════════════════════════
META_CLIENT_ID=
META_CLIENT_SECRET=
META_GRAPH_VERSION=v25.0
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202606

# Optional WooCommerce store integration (restricted to one explicit org)
WOOCOMMERCE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
WOOCOMMERCE_WEBHOOK_SECRET=
WOOCOMMERCE_ORGANIZATION_ID=

# Exact alternate gateway base URLs permitted to receive organization keys
OMNIROUTE_ALLOWED_BASE_URLS=

# Optional self-hosted AI/workflow sidecars (`docker compose --profile ai up -d`)
N8N_ENCRYPTION_KEY=
N8N_HOST=localhost
N8N_EDITOR_BASE_URL=http://localhost:3000/automation/
N8N_WEBHOOK_URL=http://localhost:3000/automation/
N8N_EKVAAR_WEBHOOK_URL=http://n8n:5678/automation/webhook/ekvaar-marketing
N8N_EKVAAR_WEBHOOK_SECRET=
N8N_EKVAAR_WORKFLOW_ID=
N8N_EKVAAR_EDITOR_URL=/automation/
COGNEE_LLM_API_KEY=
COGNEE_LLM_MODEL=openai/auto
DOGRAH_API_URL=
OPEN_DESIGN_API_TOKEN=
OPEN_DESIGN_ALLOWED_ORIGINS=http://localhost:3000
OPEN_DESIGN_PUBLIC_URL=
RAKAZO_PUBLIC_URL=

# ENVIRONMENT
ENV=production
NODE_ENV=production
CAMPAIGN_LAUNCHES_ENABLED=true
# Browser automation stays off until its worker is network-isolated.
BROWSER_AUTOMATION_ENABLED=0
BROWSE_WORKER_KEY=
