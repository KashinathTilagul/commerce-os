# EKVAAR OS Environment Configuration
# Copy this file to .env and fill in your API keys

# ============================================
# LLM API Keys (Choose at least one)
# ============================================
# OpenAI API Key (Recommended for best performance)
OPENAI_API_KEY=your_openai_api_key_here

# OpenRouter API Key (Alternative - supports many free models)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Groq API Key (Alternative - fast and free inference)
GROQ_API_KEY=your_groq_api_key_here

# ============================================
# Database Configuration
# ============================================
# For production, use PostgreSQL
DATABASE_URL=sqlite:///./data/ekvaar_business.db

# Redis URL for background jobs
REDIS_URL=redis://localhost:6379/0

# ============================================
# Security
# ============================================
JWT_SECRET=your_jwt_secret_here

# ============================================
# Environment
# ============================================
ENV=development

# ============================================
# Optional Integration Keys
# ============================================
# Shopify (for e-commerce integration)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_STORE_URL=

# Additional services can be added here