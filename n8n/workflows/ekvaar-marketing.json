    { "id": "publish-due", "name": "Publish Founder-Approved Content", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [280, 280], "parameters": { "method": "POST", "url": "={{ $env.EKVAAR_OS_INTERNAL_URL + '/api/internal/marketing/publish' }}", "sendHeaders": true, "headerParameters": { "parameters": [{ "name": "x-cron-secret", "value": "={{ $env.CRON_SECRET }}" }] }, "sendBody": true, "contentType": "raw", "rawContentType": "application/json", "body": "={}", "options": { "timeout": 180000 } } }
