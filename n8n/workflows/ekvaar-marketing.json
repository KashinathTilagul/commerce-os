    { "id": "denied", "name": "Reject Unauthorized", "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1.4, "position": [500, 100], "parameters": { "respondWith": "json", "responseBody": "={\"error\":\"Unauthorized\"}", "options": { "responseCode": 401 } } },
